# Langent Configuration Template
# Copy this to .env and fill in your values

# Workspace to scan (MD, PDF, CSV, etc.)
LANGENT_WORKSPACE="./workspace"

# Neo4j Settings
NEO4J_URI="bolt://localhost:7687"
NEO4J_USER="neo4j"
NEO4J_PASSWORD="password"

# ChromaDB Settings
CHROMA_DB_PATH="./data/chroma_db"
EMBEDDING_MODEL="all-MiniLM-L6-v2"

# Server Settings
API_HOST="0.0.0.0"
API_PORT=8000

# LLM Mode (mcp | ollama | proxy | fake)
LLM_MODE="fake"
